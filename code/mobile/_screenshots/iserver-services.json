function selectTheme(theme){
    var currentTheme = JSON.parse(localStorage.getItem("pro__DEFAULT_THEME"));
    if (currentTheme && currentTheme.value === theme) {
        return;
    }
    var themeItem = {
        "value": theme ,
        "expire": null,
    }
    localStorage.setItem("pro__DEFAULT_THEME", JSON.stringify(themeItem));
    window.location.reload();
}

function getRoles() {
    $.ajax({
        url: RoleUrl,
        success: function (res) {
            if(!(res.roles) || !((res.roles.includes('ADMIN') || res.roles.includes('PUBLISHER') || res.managePermitted.includes('Service Publishing')))
                || res.roles.length === 0){
                var element = document.getElementById("servicesManageTop");
                element.style.display = "none";
            }
        }
    })
}

    getRoles();
