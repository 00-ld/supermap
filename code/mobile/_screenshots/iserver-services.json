function changeComponentStyle(selectedType){
    var type = selectedType;
    if(theme && theme.value === "dark"){
        document.getElementById("allComponent").style.backgroundColor = (type === ''?'#ffffff0a':"");
        document.getElementById("allComponent").style.fontWeight = (type === ''?'bold':"");
        document.getElementById("allComponent").style.color = (type === ''?'#e04c40':"");
        document.getElementById("allComponent").style.borderLeft = (type === ''?'2px solid #e04c40':"2px solid transparent");
        var supportComponentTypeElementIdMap = getSupportComponentTypeElementIdMap();
        if(type === ''){
            selectedCompenent=$("#allComponent span").html();
        }
        for(var typeName in supportComponentTypeElementIdMap){
            var eleId = supportComponentTypeElementIdMap[typeName];
            document.getElementById(eleId).style.backgroundColor = (type === typeName?'#ffffff0a':"");
            document.getElementById(eleId).style.color = (type === typeName?'#e04c40':"");
            document.getElementById(eleId).style.fontWeight = (type === typeName?'bold':"");
            document.getElementById(eleId).style.borderLeft = (type === typeName?'2px solid #e04c40':"2px solid transparent");
            if(type === typeName){
                selectedCompenent=$("#"+eleId+" span").html();
            }
        }
    }else{
        document.getElementById("allComponent").style.backgroundColor = (type === ''?'#ff483e0a':"");
        document.getElementById("allComponent").style.fontWeight = (type === ''?'bold':"");
        document.getElementById("allComponent").style.color = (type === ''?'#ff483e':"");
        document.getElementById("allComponent").style.borderLeft = (type === ''?'2px solid #ff483e':"2px solid transparent");
        var supportComponentTypeElementIdMap = getSupportComponentTypeElementIdMap();
        if(type === ''){
            selectedCompenent=$("#allComponent span").html();
        }
        for(var typeName in supportComponentTypeElementIdMap){
            var eleId = supportComponentTypeElementIdMap[typeName];
            document.getElementById(eleId).style.backgroundColor = (type === typeName?'#ff483e0a':"");
            document.getElementById(eleId).style.color = (type === typeName?'#ff483e':"");
            document.getElementById(eleId).style.fontWeight = (type === typeName?'bold':"");
            document.getElementById(eleId).style.borderLeft = (type === typeName?'2px solid #ff483e':"2px solid transparent");
            if(type === typeName){
                selectedCompenent=$("#"+eleId+" span").html();
            }
        }
    }
}

function getSupportComponentTypeElementIdMap(){
    if ("false" === "true") {
        return {
            'com.supermap.services.components.impl.MapImpl': "MapImpl",
            'com.supermap.services.components.impl.DataImpl': "DataImpl",
            'com.supermap.services.components.impl.RealspaceImpl': "RealspaceImpl",
            'com.supermap.services.components.impl.GeometryComponentImpl': "GeometryComponentImpl"
        };
    }
    return ComponentTypeElementIdMap;
}
function formatNum(num) {
    return ('' + num).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

//防止XSS攻击
function xSSFilter(val) {
    val = val.toString();
    val = val.replace(/</g, "&lt;");
    val = val.replace(/>/g, "&gt;");
    val = val.replace(/"/g, "&quot;");
    val = val.replace(/'/g, "&#39;");
    return val;
}

