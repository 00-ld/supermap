    <script>
var Sys = {};
var ua = navigator.userAgent.toLowerCase();
var ieResult = ua.match(/msie ([\d.]+)/i);
var ffResult = ua.match(/firefox\/([\d.]+)/i);
var chromeResult = ua.match(/chrome\/([\d.]+)/i);
var operaResult = ua.match(/opera.([\d.]+)/i);
var safariResult = ua.match(/version\/([\d.]+)/i);
setBrowser();
function setBrowser() {
    if(window.ActiveXObject && ieResult){
        Sys.ie = ieResult[1]
    }else if(document.getBoxObjectFor && ffResult){
        Sys.firefox = ffResult[1]
    }else if(window.MessageEvent && !document.getBoxObjectFor && chromeResult){
        Sys.chrome = chromeResult[1]
    }else if(window.opera && operaResult){
        Sys.opera = operaResult[1]
    }else if(window.openDatabase && safariResult){
        Sys.safari = safariResult[1]
    }
}
function correctPNG() {
    for (var i = 0; i < document.images.length; i++) {
        var img = document.images[i];
        var imgName = img.src.toUpperCase();
        if (imgName.substring(imgName.length - 3, imgName.length) === 'PNG') {
            var imgID = (img.id) ? "id='" + img.id + "'" : "";
            var imgClass = (img.className) ? "class='" + img.className + "'" : "";
            var imgTitle = (img.title) ? "title='" + img.title + "'" : "title='" + img.alt + "'";
            var imgStyle = "display:inline-block;" + img.style.cssText;
            if (img.align === 'left') {
                imgStyle = "float:left;" + imgStyle;
            }
            else if (img.align === 'right') {
                imgStyle = "float:right;" + imgStyle;
            }
            if (img.parentElement.href) {
                imgStyle = "cursor:hand;" + imgStyle;
            }
            var strNewHTML = "<span " + imgID + imgClass + imgTitle + "style=\"" + "width:" + img.width + "px; height:" + img.height + "px;"
                + imgStyle + ";" + "filter:progid:DXImageTransform.Microsoft.AlphaImageLoader" + "(src=\'" + img.src + "\', sizingMethod='scale');\"</span>";
            img.outerHTML = strNewHTML;
            i = i - 1; //tricks NOSONAR
        }
    }
};

function getUrlParam(name) {
    //获取URL指定名字的查询字符串值
    var reg = new RegExp("[?&]" + name + "=([^?&]*)[&]?", "i");
    var match;
    match = location.search.match(reg);
    return match == null ? "" : match[1];
};

if (Sys.ie && Sys.ie < 7.0) {
    window.attachEvent("onload", correctPNG);
}
//设置语言...开始
function setCookie(c_name, value, expiredays) {
    var exdate = new Date();
    exdate.setDate(exdate.getDate() + expiredays);
    var protocol = window.location.protocol;
    var secure ="";
    if(protocol === "https:"){
        secure = ";secure=true";
    }
    var cookieVal = c_name + "=" + escape(value) + ((expiredays == null) ? "" : ";expires=" + exdate.toGMTString()) + ";path=/" + secure;
    document.cookie = cookieVal;
};
function delCookie(name) {
    var date = new Date();
    date.setTime(date.getTime() - 10000);
    document.cookie = name + "=a;expires=" + date.toGMTString() + ";path=/";
}
function selectLanguage(language) {
    delCookie("language");
    setCookie("language", language, 3600 * 24 * 31);
    window.location.reload();
};
function pareWidth() {
    var instances = $(".serverList ul li.subServiceList a");
    var menuWidth = $(".topWrapper").width();
    var componentCount = 43;
    var interfaceCount = 13;
    if (menuWidth < 1600 && menuWidth > 1440) {
        componentCount = 33;
    } else if (menuWidth < 1440) {
        componentCount = 24;
    }
    for (var i = 0; i < instances.length; i++) {
        var instanceName = $(instances[i]).attr('title');
        if (!instanceName || instanceName.length < componentCount + interfaceCount + 1) {
            continue;
        }
        var componentName = instanceName.split("/")[0];
        var interfaceName = instanceName.split("/")[1];
        if (componentName.length > componentCount && interfaceName.length > interfaceCount) {
            componentName = componentName.substring(0, componentCount - 3) + "...";
            interfaceName = interfaceName.substring(0, interfaceCount - 3) + "...";
        } else if (componentName.length > componentCount && interfaceName.length <= interfaceCount) {
            componentName = componentName.substring(0, componentCount + (interfaceCount - interfaceName.length) - 3) + "...";
        } else if (componentName.length <= componentCount && interfaceName.length > interfaceCount) {
            interfaceName = interfaceName.substring(0, interfaceCount + (componentCount - componentName.length) - 3) + "...";
        }
        $(instances[i]).text(componentName + "/" + interfaceName);
    }
}    </script>
