    "com.supermap.services.ogcapi.OGCAPIServlet": "OGCAPI "+listServiceRes.service,
    "other": listServiceRes.otherService
};
var serviceUrl = "http://8.130.175.232:18090/iserver/services.json?pageSize=100&currentPage=1";
var queryString = "";
var currentPage = 1;
var keywords = "";
var componentType = "";
var interfaceTypes = "";
var selectedInterfaceFilter = "";
var status = "";
var totalservices = 0;
var selectedCompenent=listServiceRes.allServices;
var selectedInterface=listServiceRes.allInterfaces;
var RoleUrl = "http://8.130.175.232:18090/iserver/services/security/profile.json?returnPermittedService=false";
if(queryString && queryString.indexOf("status=")>-1){
    var kvs = queryString.split("&");
    for(var i = 0;i< kvs.length;i++){
        var kv = kvs[i].split("=");
        if(kv[0] === "status" && kv[1] === "OK"){
            status = "OK";
        }
    }
}
changeComponentStyle('');
fetchData(100,currentPage,"",status,componentType, interfaceTypes);
function fetchData(pageSize,currentPage,keywords,status,componentType,filterInterfaceTypes){
    var statusFilter = (status === undefined || status === null || status === "") ? "" : "&status="+status;
    var interfaceTypesFilter = (filterInterfaceTypes !== null && filterInterfaceTypes !== undefined && filterInterfaceTypes.length>0) ? "&interfaceTypes="+filterInterfaceTypes : "";
    var url = "http://8.130.175.232:18090/iserver/services.json?pageSize="+pageSize+"&currentPage="+currentPage+"&keywords="+keywords+statusFilter+"&componentType="+componentType+interfaceTypesFilter;
    $.ajax({
        type : "GET",
        url : url,
        async : false,
        dataType : "json",
        success : function(response) {
            $("#count_componentType").html(selectedCompenent);
            $("#count_interfaceType").html(selectedInterface);
            renderTable(response);
            $('#pagination').pagination(totalservices,{
                callback:function(page){
                    console.log(page);
                    fetchData(100,page+1,keywords,status,componentType,interfaceTypes);
                },
                prev_text:"<",
                next_text:">",
                items_per_page:100,
                num_edge_entries:2,
                num_display_entries:3,
                prev_show_always:false,
                next_show_always:false,
                current_page:currentPage-1
            })
        }
    })
}
function getInterfaceColumnTitle(){
    var html = "";
    var handlerInterface = "";
    if ("false" === "false") {
        handlerInterface = "<li id='HandlerInterface' onClick='setInterfaceType(\"Handler\")'><a>Handler " + listServiceRes.service + "</a></li>";
    }
    html = html + "<div class='btn-group' id='interfaceColumnTitle'>" +
        "<a class='btn' id='interfaceColumnName' data-toggle='dropdown'>" +
        "<span style='margin-right:5px;'>"+listServiceRes.serviceInterfaceType+"</span>" +
        "<span class='caret'></span>" +
        "</a>" +
        "<ul class='dropdown-menu' role='menu'>" +
            "<li id='ALLInterface' onClick='setInterfaceType(\"ALL\")'><a>"+listServiceRes.allServices+"</a></li>" +
            "<li id='OGCInterface' onClick='setInterfaceType(\"OGC\")'><a>OGC "+listServiceRes.service+"</a></li>" +
            "<li id='RESTInterface' onClick='setInterfaceType(\"REST\")'><a>REST "+listServiceRes.service+"</a></li>" +
            handlerInterface +
            "<li id='otherInterface' onClick='setInterfaceType(\"other\")'><a>"+listServiceRes.otherServices+"</a></li>" +
        "</ul>" +
        "</div>";
    return html;
}
function renderTable(response){
    $("#totalCount").html(formatNum(response.total));
    totalservices=response.total;
    
    $("#table").html("");
    $("#nodata").html("");
    $("#table").append("<tr class='tablehead' style='height: 48px;vertical-align: middle;'>\n" +
        "                            <th class='serviceName' style='width:30%'>"+listServiceRes.serviceName+"</th>\n"+
        "                            <th class='serviceAlias' style='width:20%'>"+listServiceRes.serviceAlias+"</th>\n" +
        "                            <th class='interfaceType' style='width:20%'>"+listServiceRes.serviceInterfaceType+"</th>\n" +
        "                            <th class='componentType' style='width:20%'>"+listServiceRes.serviceComponentType+"</th>\n" +
        "                            <th class='status' style='width:10%'>"+listServiceRes.serviceStatus+"</th>\n" +
        "                        </tr>");
    $("#table").append("</tr>");
    setInterfaceFilterStyle();
    if(response.content.length===0){
        $("#nodata").append("<svg class='nodataIcon' style='width:80px;height:80px;margin-top: 72px;vertical-align:middle'><image xlink:href='http://8.130.175.232:18090/iserver/services/../manager/static/css/iserver/images/menu/newpage/nodata.svg' width='80' height='80'/></svg>");
        $("#nodata").append("<div class='nodataText'>"+listServiceRes.nodata+"</div>");
        return;
    }
    for(var i=0;i<response.content.length;i++){
        var item = response.content[i]
        var interfaceName = interfaceTypeName[item.interfaceType];
        if(interfaceName === undefined){
            interfaceName = item.interfaceType;
        }
        var componentName = serviceTypeName[item.componentType];
        if(componentName === undefined){
            componentName = serviceTypeRes.DomainService;
        }
        var status = "";
        if(item.status==="Created"){
            status = "<img style='width:16px;height:16px;' title='"+listServiceRes.created+"' src='http://8.130.175.232:18090/iserver/services/../manager/static/img/inited.png' />";
        }else{
            status = "<img style='width:16px;height:16px;' title='"+listServiceRes.started+"' src='http://8.130.175.232:18090/iserver/services/../manager/static/img/started.png' />";
        }
        var serviceAddress = "http://8.130.175.232:18090/iserver/services/"+item.name;
        var alias = item.alias;
        $("#table").append("<tr class='serviceItem'><td class='wordBreak serviceLink'><a href='"+serviceAddress+"' target='_blank' data-toggle='tooltip' title='"+item.name+"'>"+item.name+"</td><td class='wordBreak serviceLink''><a href='"+serviceAddress+"' target='_blank' data-toggle='tooltip' title='"+xSSFilter(alias)+"'>"+xSSFilter(alias)+"</a></td><td class='wordBreak'>"+interfaceName+"</td><td class='wordBreak'>"+componentName+"</td><td>"+status+"</td></tr>");
        $('[data-toggle="tooltip"]').tooltip();
    }
}

$("#searchByKeywords").click(function(){
    search();
})
$("#keywords").keydown(function(event){
    if((event.keyCode || event.which) === 13){
        search();
    }
})

$(".serviceLink").mouseover(function(){
    const contentWidth=$(this).context.offsetWidth - 16;
    const childWidth=$(this).context.children[0].offsetWidth;
    if(childWidth < contentWidth){
        $('[data-toggle="tooltip"]').tooltip('hide');
    }else{
        $('[data-toggle="tooltip"]').tooltip();
    }

})
function search(){
    const newLineReg = /[\r\n]/g
    keywords = $("#keywords").val();
    if(keywords.length > 1000){
        $("#searchErrMsg").html(listServiceRes.lengthErrMsg);
    }else if(newLineReg.test(keywords)){
        $("#searchErrMsg").html(listServiceRes.CRLFErrMsg);
    }else {
        $("#searchErrMsg").empty();
        currentPage = 1;
        fetchData(100,currentPage,keywords,status,componentType,interfaceTypes);
    }
}
function setComponentType(type){
    componentType = type;
    currentPage = 1;
    changeComponentStyle(type);
    fetchData(100,currentPage,keywords,status,componentType,interfaceTypes);
}
/*function showSelectInterfaceType(){
    document.getElementById("selectInterfacePanel").style.display = 'block';
}*/
function getAllInterfaceFilterTypes(){
    if ("false" === "true") {
        return ['ALL','OGC','REST','other'];
    }
    return ['ALL','OGC','REST','Handler','other'];
}
function setInterfaceFilterStyle(){
    var allFilterTypes = getAllInterfaceFilterTypes();
    if(selectedInterfaceFilter===''){
        selectedInterfaceFilter='ALL';
        selectedInterface=$("#ALLInterface").html();
    }
    for(var i=0;i<allFilterTypes.length;i++){
        let color = '';
        if(selectedInterfaceFilter === allFilterTypes[i]){
            if(theme && theme.value==="dark"){
                color = '#e04c40';
            }else{
                color = '#ff483e';
            }
            selectedInterface=$("#"+allFilterTypes[i]+'Interface').html();
        }
        document.getElementById(allFilterTypes[i]+'Interface').style.color = color;
    }
}
function setInterfaceType(value){
    selectedInterfaceFilter = value;
    setInterfaceFilterStyle();
    interfaceTypes = getInterfaceTypes(value);
    fetchData(100,currentPage,keywords,status,componentType,interfaceTypes);
}

function getInterfaceTypes(catalog){
    if(catalog===undefined || catalog===null || catalog === 'ALL'){
        return "";
    }
    if(catalog === 'OGC'){
        return "com.supermap.services.wms.WMSServlet,com.supermap.services.wfs.WFSServlet,com.supermap.services.wmts.WMTSServlet,com.supermap.services.wcs.WCSServlet,com.supermap.services.wps.WPSServlet";
    }else if(catalog === 'REST'){
        return "com.supermap.services.rest.JaxrsServletForJersey,com.supermap.services.rest.RestServlet";
    }else if(catalog === 'Handler'){
        return "com.supermap.services.handler.HandlerServlet";
    }else{
        return "other";
    }
}
