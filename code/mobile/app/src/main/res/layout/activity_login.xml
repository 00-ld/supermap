<?xml version="1.0" encoding="utf-8"?>
<!-- 极简清爽 iOS 风格登录页：渐变品牌头部 + 纯白表单卡 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground">

    <!-- 顶部渐变品牌区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_login_hero"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="56dp">

        <!-- Logo 圆形光晕 -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_login_logo_halo" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_app_logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 顶部服务端 Endpoint 配置快捷按钮 -->
    <ImageButton
        android:id="@+id/ibServerSettingsLogin"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_quick_action"
        android:contentDescription="服务端配置"
        android:elevation="6dp"
        android:padding="8dp"
        android:src="@drawable/ic_action_settings"
        app:tint="#0F172A" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="200dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp">

            <!-- 纯白 16dp 圆角卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:text="账号安全登录"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUsername"
                    style="@style/LoginField"
                    android:hint="@string/hint_username"
                    android:inputType="text"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/LoginField"
                    android:layout_marginTop="14dp"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/btnLogin"
                    style="@style/AppButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="26dp"
                    android:text="@string/btn_login" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLicenseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textColor="@color/textMuted"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
