<?xml version="1.0" encoding="utf-8"?>
<!-- SuperMap iMobile 2026 极简 iOS 风格地图主界面（含毒气气象挂件与 2D/3D 模式切换） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground">

    <!-- SuperMap iMobile MapView 核心地图 -->
    <com.supermap.mapping.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部极简 HUD 芯片面板 -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:elevation="6dp"
        android:visibility="gone">

        <!-- 坐标与比例尺 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_panel_dark"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lngLatText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="经度: --  纬度: --" />

            <TextView
                android:id="@+id/scaleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="1:--" />
        </LinearLayout>

        <!-- 气象与毒气扩散避险感应挂件 -->
        <LinearLayout
            android:id="@+id/gasSensorWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_panel_half"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_danger"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="气象威胁感应"
                android:textColor="@color/dangerText"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWeatherAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="东北风 3.2m/s | 建议避开下风向 150 米"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 右侧纯白极简悬浮操控杠 -->
    <LinearLayout
        android:id="@+id/mapToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_half"
        android:padding="6dp"
        android:layout_marginEnd="14dp"
        android:elevation="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_map_zoom_in"
            android:contentDescription="放大" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_map_zoom_out"
            android:contentDescription="缩小" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <ImageButton
            android:id="@+id/btnReset"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_map_reset"
            android:contentDescription="复位" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <ImageButton
            android:id="@+id/btnLegend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_map_legend"
            android:contentDescription="图例" />
    </LinearLayout>

    <!-- 任务引导卡：仅从事故/巡检任务进入时展示，半透明玻璃覆盖且不遮挡地图。 -->
    <LinearLayout
        android:id="@+id/navigationPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNavigationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseNavigation"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="关闭导航"
                android:src="@drawable/ic_map_reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNavigationInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRefreshNavigation"
            style="@style/AppButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:text="重新定位并更新引导" />
    </LinearLayout>

    <!-- 点位详情弹窗 Callout：点击地图上的事故/巡检车点位时弹出 -->
    <LinearLayout
        android:id="@+id/calloutPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/bg_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/calloutTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/calloutCloseBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="关闭"
                android:src="@drawable/ic_back_arrow"
                android:rotation="45" />
        </LinearLayout>

        <TextView
            android:id="@+id/calloutDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/calloutActionBtn"
            style="@style/AppButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:text="查看详情"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 底部纯白极简折叠图例抽屉 -->
    <LinearLayout
        android:id="@+id/legendPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_panel_half"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超图矢量图层 &amp; 毒气扩散缓冲区图例"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <include layout="@layout/item_legend_row" />
    </LinearLayout>

    <!-- 加载浮层 -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/loadStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/map_loading"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/retryButton"
            style="@style/AppButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/btn_retry"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
