# Chemical park monitoring system environment template.
# Copy this file to `.env` on the server and replace every placeholder.
# Never commit the real `.env` file to GitHub.

# MySQL
# 生成强随机密码示例：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password
MYSQL_DATABASE=chemical
# 应用账号固定为 appuser（见 docker-compose.yml 与 init_appuser.sql），
# backend 连接数据库使用此最小权限账号而非 root；只通过环境变量轮换密码。
MYSQL_APP_PASSWORD=replace_with_strong_app_password

# Java backend
SPRING_PROFILES_ACTIVE=docker

# Default area name stored for image-analysis inspection records.
INSPECTION_DEFAULT_LOCATION=核心作业区 A7

# JWT signing secret. Use at least 32 random characters.
# Example: openssl rand -hex 32
JWT_SECRET=replace_with_random_32_char_min_secret

# Shared key used by Nginx / Java backend when calling Python algorithms.
# Example: openssl rand -hex 24
ALGORITHM_API_KEY=replace_with_random_algorithm_key
# Require X-API-Key on Python algorithm APIs in production.
ALGORITHM_REQUIRE_AUTH=true

# YOLO/person analysis service used by Java backend.
# docker-compose starts the internal service below; keep this URL unless using
# an external controlled inference endpoint.
ANALYSIS_SERVICE_URL=http://yolo:8001/api/analysis/person
YOLO_MODEL_PATH=/app/models/yolo11m.pt
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=1024
YOLO_CONFIDENCE=0.35

# QWeather backend proxy. Keep the real key only in the deployment environment.
# QWEATHER_LOCATION can be a QWeather LocationID or longitude,latitude.
QWEATHER_API_KEY=
QWEATHER_LOCATION=
QWEATHER_API_HOST=https://devapi.qweather.com
QWEATHER_AUTH_MODE=key

# Qwen emergency decision support. Keep the real key on the backend only.
DECISION_MODEL_ENABLED=false
DECISION_MODEL_PROVIDER=qwen
DECISION_MODEL_NAME=qwen-plus
DECISION_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DECISION_MODEL_API_KEY=
DECISION_MODEL_TIMEOUT_MS=30000
DECISION_MODEL_TEMPERATURE=0.1
DECISION_MODEL_MAX_TOKENS=1800
# Semicolon-separated approved Markdown files mounted on the backend host/container.
DECISION_MODEL_EVIDENCE_PATHS=/app/docs/chemical-park-alarm-response-plans.md;/app/docs/chemical-park-leak-emergency-response.md

# Java backend CORS allowlist.
CORS_ALLOWED_ORIGINS=http://www.cip.lab6119.xyz,https://www.cip.lab6119.xyz

# Python algorithm CORS allowlist.
ALGORITHM_CORS_ORIGINS=http://www.cip.lab6119.xyz,https://www.cip.lab6119.xyz
