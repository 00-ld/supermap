# 本地开发环境配置模板（复制为 .env.local 后使用，.env.local 会被 git 忽略）
# 这些值仅用于 127.0.0.1 本地开发会话。

DB_USERNAME=root
DB_PASSWORD=替换为本地MySQL密码
MYSQL_ROOT_PASSWORD=替换为本地MySQL密码
MYSQL_APP_PASSWORD=替换为本地MySQL应用密码
MYSQL_DATABASE=chemical

JWT_SECRET=替换为随机32字符以上字符串
# 本地开发关闭算法鉴权，前端无需配 API Key
ALGORITHM_REQUIRE_AUTH=false
ALGORITHM_API_KEY=替换为随机字符串

SUPERMAP_START_DESKTOP=false
DECISION_MODEL_ENABLED=false
DECISION_MODEL_PROVIDER=qwen
DECISION_MODEL_NAME=qwen-plus
DECISION_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DECISION_MODEL_API_KEY=
DECISION_MODEL_TIMEOUT_MS=30000
