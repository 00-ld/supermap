# 本地运行用构建产物（可选，开发阶段用 npm run dev 即可，无需 build）
# 后端/算法服务走相对路径，由 Nginx 或 vite 代理转发到 127.0.0.1。
VITE_APP_BASE_API = /api
VITE_ALGORITHM_BASE_API = /algorithm-api
# iPortal 数字大屏：本地无 SuperMap iPortal 时可置空，三维大屏页面会显示加载失败占位而非崩溃。
